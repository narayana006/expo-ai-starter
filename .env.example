# --- App (bundled into the binary, so never put secrets here) ---
# URL of the chat proxy as seen from the device.
# iOS simulator: http://localhost:8787   Android emulator: http://10.0.2.2:8787
# Physical device: http://<your computer's LAN address>:8787
EXPO_PUBLIC_CHAT_API_URL=http://localhost:8787

# --- Proxy (server only; set these in the server's environment, not in the app) ---
# The proxy does not read this file by itself. Start it with:
#   node --env-file=.env server/index.ts
# Leave UPSTREAM_BASE_URL empty to stay in mock mode.
PORT=8787
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
UPSTREAM_MODEL=
SYSTEM_PROMPT=
# MOCK=1                      # force mock mode even when an upstream is set
# ALLOWED_ORIGIN=*            # Access-Control-Allow-Origin, for browser clients
# RATE_LIMIT_PER_MINUTE=30    # per client address; 0 disables
# MAX_MESSAGES=50
# MAX_TOTAL_CHARS=32000
# MOCK_DELAY_MS=40
