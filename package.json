{
  "name": "expo-ai-starter",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "server": "node server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "expo": "~58.0.23",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3",
    "test-renderer": "^1.3.1"
  },
  "engines": {
    "node": ">=22.18"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/helpers/"
    ]
  }
}
